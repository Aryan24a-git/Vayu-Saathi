# Clear Air Companion — Environment Variables
# Copy to .env.local and fill in values
# NEVER commit .env.local to source control

# =============================================================================
# LLM Provider (server-side only — NEVER use NEXT_PUBLIC_ prefix)
# =============================================================================
# Google Gemini API key (get from https://aistudio.google.com)
# Leave empty to use deterministic fallback (no AI narrative)
GEMINI_API_KEY=

# LLM model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Daily token budget (requests exceeding this get deterministic fallback)
LLM_DAILY_TOKEN_BUDGET=1000000

# Max tokens per plan generation
LLM_MAX_TOKENS_PER_PLAN=2048

# =============================================================================
# Cache Configuration
# =============================================================================
# AQI data cache TTL in minutes (default: 15)
AQI_CACHE_TTL_MINUTES=15

# AQI cache max entries (LRU)
AQI_CACHE_MAX_ENTRIES=500

# LLM plan cache TTL in minutes (default: 30)  
LLM_CACHE_TTL_MINUTES=30

# LLM plan cache max entries (LRU)
LLM_CACHE_MAX_ENTRIES=100

# Geocoding cache TTL in hours (default: 24)
GEOCODE_CACHE_TTL_HOURS=24

# Geocode cache max entries
GEOCODE_CACHE_MAX_ENTRIES=200

# =============================================================================
# Rate Limiting
# =============================================================================
# /api/plan requests per minute per IP
RATE_LIMIT_PLAN_PER_MINUTE=10

# /api/aqi requests per minute per IP
RATE_LIMIT_AQI_PER_MINUTE=60

# /api/geocode requests per minute per IP
RATE_LIMIT_GEOCODE_PER_MINUTE=30

# /api/followup requests per minute per IP
RATE_LIMIT_FOLLOWUP_PER_MINUTE=20

# =============================================================================
# Provider Configuration
# =============================================================================
# AQI provider timeout in milliseconds (default: 5000)
AQI_PROVIDER_TIMEOUT_MS=5000

# AQI provider retry count (default: 2)
AQI_PROVIDER_RETRY_COUNT=2

# LLM provider timeout in milliseconds (default: 10000)
LLM_PROVIDER_TIMEOUT_MS=10000

# =============================================================================
# Application
# =============================================================================
# Node environment (development | production | test)
NODE_ENV=development

# Log level (debug | info | warn | error)
LOG_LEVEL=info
