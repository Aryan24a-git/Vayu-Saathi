# =============================================================================
# Clear Air Companion — Environment Configuration (.env.example)
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# LLM Provider Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
LLM_ENABLED=true
LLM_DAILY_CALL_CAP=1000

# Air Quality & Geocoding Provider
AQ_PROVIDER=open-meteo

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PLAN=6
RATE_LIMIT_AQI=60
RATE_LIMIT_GEOCODE=30
RATE_LIMIT_FOLLOWUP=20

# Security & Logging
TRUSTED_PROXY_HEADER=x-forwarded-for
CLIENT_IP_SALT=replace_with_at_least_16_char_random_salt
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
