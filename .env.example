# =============================================================================
# Clear Air Companion — Environment Configuration (.env.example)
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# LLM Provider Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=claude-3-5-haiku-20241022
LLM_ENABLED=true
LLM_DAILY_CALL_CAP=1000

# Air Quality & Geocoding Provider
AQ_PROVIDER=open-meteo

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PLAN=10
RATE_LIMIT_AQI=60
RATE_LIMIT_GEOCODE=30
RATE_LIMIT_FOLLOWUP=20

# Application & Logging
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
